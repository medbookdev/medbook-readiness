@startuml
title Врачебный приём
|Врач, пациент и регистратор|
start
|Врач, пациент и регистратор|
:Провести зарегистрированный приём\n[На стенде];
switch (Цель работы)
case (Расписание)
|Врач|
:Изменить часы приёма\n[На стенде];
case (Приём)
|Врач|
:Описать визит и создать направление\n[Есть часть];
|Пациент|
:Получить итог визита\n[Нет подтверждения];
case (Видеоконсультация)
|Врач и пациент|
:Провести видеоприём\n[Есть часть];
endswitch
stop
@enduml
