@startuml
title Врачебный приём
|Врач, пациент и регистратор|
start
|Врач, пациент и регистратор|
:Провести зарегистрированный приём\n[На стенде];
switch (Цель работы)
case (Расписание)
|Врач|
:Изменить часы приёма\n[На стенде];
case (Приём)
|Два врача|
:Обменяться итогом консультации\n[На стенде];
|Пациент|
:Прочитать письмо врача\n[Есть часть];
case (Видеоконсультация)
|Врач и пациент|
:Провести видеоприём\n[Есть часть];
endswitch
stop
@enduml
