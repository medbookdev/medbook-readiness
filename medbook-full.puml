@startuml medbook-overview
!pragma layout smetana
skinparam shadowing false
top to bottom direction
title Карта процессов Medbook
rectangle "Medbook" as medbook
package "Клиническая помощь" as g0 {
rectangle "Поиск и запись" as care
rectangle "Врачебный приём" as visit
rectangle "Назначения и аптеки" as medication
rectangle "Лаборатория" as lab
}
medbook --> g0
package "Работа учреждения" as g1 {
rectangle "Клиника и смены" as staff
rectangle "Регистратура и управление" as clinic
}
medbook --> g1
package "Личные данные и ИИ" as g2 {
rectangle "Личные данные WHOOP" as whoop
rectangle "Помощник Medbook" as ai
}
medbook --> g2
care --> visit : После принятия заявки
visit --> medication : Лекарственное назначение
visit --> lab : Направление на исследование
rectangle "Сборка и выпуск" as release
g0 ..> release
g1 ..> release
g2 ..> release
note right of release
Для изменений во всех путях
end note
@enduml

@startuml medbook-care
skinparam shadowing false
title Поиск и запись
|Пациент|
start
switch (Пациент выбирает маршрут)
case (Открыть справочник)
|Пациент|
:Открыть справочники\n[На демо];
case (Перейти в демозапись)
|Пациент|
:Выбрать время\n[На демоданных];
|Пациент|
:Отправить заявку\n[На стенде];
|Врач|
:Ответить на заявку\n[На стенде];
|Пациент|
:Вернуться в кабинет и управлять записью\n[На стенде];
endswitch
stop
@enduml

@startuml medbook-visit
skinparam shadowing false
title Врачебный приём
|Врач, пациент и регистратор|
start
|Врач, пациент и регистратор|
:Провести зарегистрированный приём\n[На стенде];
switch (Цель работы)
case (Расписание)
|Врач|
:Изменить часы приёма\n[На стенде];
case (Приём)
|Два врача|
:Обменяться итогом консультации\n[На стенде];
|Пациент|
:Прочитать письмо врача\n[На стенде];
case (Видеоконсультация)
|Врач и пациент|
:Провести видеоприём\n[Есть часть];
endswitch
stop
@enduml

@startuml medbook-whoop
skinparam shadowing false
title Личные данные WHOOP
|Пациент|
start
|Пациент|
:Подключить свой аккаунт WHOOP\n[На демо];
|Сервер|
:Сохранить измерения\n[На демо];
|Пациент|
:Открыть только свои данные\n[На стенде];
|ИИ|
:Объяснить динамику\n[Выключено];
stop
@enduml

@startuml medbook-staff
skinparam shadowing false
title Клиника и смены
|Сотрудник|
start
|Сотрудник|
:Принять приглашение\n[На стенде];
|Сотрудник|
:Посмотреть свою смену\n[На стенде];
|Два сотрудника|
:Запросить и принять обмен\n[На стенде];
|Руководитель|
:Одобрить заявку\n[На стенде];
|Учреждение и сотрудники|
:Сверить смену с опубликованным графиком\n[На стенде];
stop
@enduml

@startuml medbook-medication
skinparam shadowing false
title Назначения и аптеки
|Пациент|
start
|Пациент|
:Найти препарат и филиал\n[На демо];
|Врач|
:Сверить назначения разных врачей\n[Есть часть];
|Врач|
:Оценить конфликт или замену\n[Нет подтверждения];
|Аптека|
:Подтвердить остаток и цену\n[Нет подтверждения];
|Фармацевт|
:Отпустить препарат по назначению\n[Нет подтверждения];
stop
@enduml

@startuml medbook-lab
skinparam shadowing false
title Лаборатория
|Врач и пациент|
start
|Врач и пациент|
:Назначить исследование\n[На стенде];
|Сотрудник лаборатории|
:Принять заказ своей клиники\n[На стенде];
|Администратор лаборатории|
:Зарегистрировать образец\n[На стенде];
|Лаборант|
:Проверить рабочий список и результат\n[Есть часть];
|Врач|
