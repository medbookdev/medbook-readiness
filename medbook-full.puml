@enduml

@startuml medbook-clinic
skinparam shadowing false
title Регистратура и управление
|Регистратура|
start
switch (Операция учреждения)
case (Регистратура)
|Регистратура|
:Отметить прибытие пациента\n[На стенде];
case (Кадры)
|Руководитель|
:Вести персонал и заявки на услуги\n[На стенде];
case (Снабжение и расчёты)
|Закупщик|
:Проверить закупку и комиссию\n[На стенде];
|Склад и бухгалтерия|
:Сверить поставку, оплату и остаток\n[Есть часть];
endswitch
stop
@enduml

@startuml medbook-ai
skinparam shadowing false
title Помощник Medbook
|Пользователь|
start
|Пользователь|
:Задать вопрос под своей ролью\n[На стенде];
|Шлюз ИИ|
