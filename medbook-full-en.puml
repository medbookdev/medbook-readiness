@startuml medbook-overview
!pragma layout smetana
skinparam shadowing false
top to bottom direction
title Medbook workflow map
rectangle "Medbook" as medbook
package "Clinical care" as g0 {
rectangle "Find and book care" as care
rectangle "Clinical visit" as visit
rectangle "Prescriptions and pharmacies" as medication
rectangle "Laboratory" as lab
}
medbook --> g0
package "Clinic operations" as g1 {
rectangle "Clinic shifts" as staff
rectangle "Front desk and operations" as clinic
}
medbook --> g1
package "Personal data and AI" as g2 {
rectangle "Personal WHOOP data" as whoop
rectangle "Medbook assistant" as ai
}
medbook --> g2
care --> visit : After a request is accepted
visit --> medication : Medication order
visit --> lab : Diagnostic order
rectangle "Build and release" as release
g0 ..> release
g1 ..> release
g2 ..> release
note right of release
Applies to changes across all journeys
end note
@enduml

